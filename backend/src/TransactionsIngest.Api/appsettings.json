{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TransactionsDb": "Data Source=transactions.db"
  },
  "Import": {
    "ReconciliationWindowHours": 24,
    "EnableFinalization": true
  },
  "TransactionSources": {
    "SampleDataPath": "SampleData",
    "Sources": [
      { "Name": "Store Uptown", "File": "store-uptown.json", "Enabled": true, "SimulateFailure": false },
      { "Name": "Store Downtown", "File": "store-downtown.json", "Enabled": true, "SimulateFailure": false },
      { "Name": "Online", "File": "online.json", "Enabled": true, "SimulateFailure": false }
    ]
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
